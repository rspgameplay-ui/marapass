 nwr(area.ma)["name"]["amenity"~"^(restaurant|cafe|fast_food|food_court|bar|fuel|pharmacy|hospital|bus_station|ferry_terminal|marketplace|atm|bank)$"];
 nwr(area.ma)["name"]["shop"~"^(craft|art|souvenir)$"];
